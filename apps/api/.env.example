# Copiaza acest fisier in `.env` (in acelasi folder) si ajusteaza valorile.
# `.env` NU se pune in Git; acest exemplu da.

# Conexiunea la PostgreSQL: utilizator `ro_a11y`, parola `ro_a11y`, baza `ro_a11y`.
DATABASE_URL="postgresql://ro_a11y:ro_a11y@localhost:5432/ro_a11y"

# Portul pe care asculta API-ul.
PORT=3000

# Nivelul logurilor: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# development | test | production
NODE_ENV=development

# --- Scanner (worker) ---

# Browserul folosit pentru scanare:
#   chrome   = Google Chrome instalat (necesar pe macOS 13; merge si pe Windows)
#   msedge   = Microsoft Edge instalat
#   chromium = Chromium descarcat de Playwright (`npx playwright install chromium`)
BROWSER_CHANNEL=chrome

# Origini locale pe care scannerul are voie sa le deschida (DOAR pentru dezvoltare si teste).
# Orice alta adresa locala sau privata (localhost, 192.168.x.x etc.) este blocata.
SCAN_ALLOWED_LOCAL_ORIGINS=http://localhost:4000

# Timpul maxim de incarcare a unei pagini (milisecunde).
SCAN_PAGE_TIMEOUT_MS=30000

# Cat de des verifica worker-ul daca au aparut scanari noi (milisecunde).
WORKER_POLL_INTERVAL_MS=2000
