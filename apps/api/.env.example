# Copiază acest fișier în `.env` (în același folder) și ajustează valorile.
# `.env` NU se pune în Git; acest exemplu da.

# Conexiunea la PostgreSQL: utilizator `ro_a11y`, parolă `ro_a11y`, bază `ro_a11y`.
DATABASE_URL="postgresql://ro_a11y:ro_a11y@localhost:5432/ro_a11y"

# Portul pe care ascultă API-ul.
PORT=3000

# Nivelul logurilor: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# development | test | production
NODE_ENV=development
