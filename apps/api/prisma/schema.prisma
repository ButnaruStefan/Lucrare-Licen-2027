// Schema bazei de date: descrie tabelele (modelele) si relatiile dintre ele.
// Din acest fisier, Prisma genereaza:
//   1) migratiile SQL (prisma/migrations/) care creeaza tabelele in PostgreSQL;
//   2) clientul TypeScript (src/generated/prisma/) cu care API-ul citeste si scrie date.
// Adresa bazei de date NU e aici, ci in prisma.config.ts (citita din .env).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Conventia de denumire:
//   - in cod (TypeScript), numele sunt in stilul camelCase: Scan, pageUrl, createdAt;
//   - in baza de date (ce vezi in Prisma Studio si in SQL), in stilul snake_case, la plural
//     pentru tabele: scans, page_url, created_at. Legatura e facuta de @map si @@map.
//
// Relatiile, pe scurt:
//   Project 1 ── N Scan 1 ── N RuleResult 1 ── N AffectedElement
//   (un proiect are mai multe scanari; o scanare are cate un rezultat pentru fiecare regula
//    verificata; un rezultat poate afecta mai multe elemente din pagina)

// ─── Liste de valori permise (enum) ─────────────────────────────────────────────

// Starea unei scanari. Scanarile "queued" formeaza coada de lucru a worker-ului care ruleaza scanarile.
enum ScanStatus {
  queued // in asteptare
  running // in curs
  completed // terminata cu rezultate
  failed // esuata (eroare tehnica, NU inseamna ca site-ul e inaccesibil)

  @@map("scan_status")
}

// Cele patru categorii de rezultate ale axe-core pentru o regula.
enum ResultCategory {
  violation // problema detectata
  incomplete // motorul nu poate decide: cere verificare umana
  pass // regula trecuta (NU inseamna conformitate generala)
  inapplicable // regula nu se aplica acestei pagini

  @@map("result_category")
}

// Gravitatea raportata de axe-core (nu e risc juridic si nici scor de conformitate).
enum Impact {
  minor
  moderate
  serious
  critical

  @@map("impact")
}

// ─── Tabele ─────────────────────────────────────────────────────────────────────

// Un proiect = un site analizat (ex. site-ul unei universitati).
model Project {
  id        String   @id @default(uuid())
  name      String // numele afisat, ex. "Primaria Valea Verde"
  baseUrl   String   @map("base_url") // adresa principala a site-ului
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  scans Scan[]

  @@map("projects")
}

// O scanare = o rulare a motorului axe-core pe o pagina, la un moment dat,
// cu o configuratie fixata (ca rezultatele sa fie reproductibile si comparabile).
model Scan {
  id             String     @id @default(uuid())
  projectId      String     @map("project_id") // proiectul caruia ii apartine
  project        Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pageUrl        String     @map("page_url") // adresa paginii scanate
  finalUrl       String?    @map("final_url") // adresa reala dupa redirectionari
  httpStatus     Int?       @map("http_status") // codul HTTP primit la incarcarea paginii
  status         ScanStatus @default(queued)
  wcagProfile    String     @default("WCAG_2_2_AA") @map("wcag_profile") // standardul verificat
  config         Json // viewport, limba, timeout etc. — fixate la creare
  engineName     String?    @map("engine_name") // ex. "axe-core"
  engineVersion  String?    @map("engine_version") // ex. "4.13.0"
  browserVersion String?    @map("browser_version") // ex. "Chrome 155.0.8059.40"
  rawAxeResult   Json?      @map("raw_axe_result") // rezultatul brut, pastrat neschimbat ca dovada
  errorCode      String?    @map("error_code") // ex. "NAVIGATION_TIMEOUT" (doar daca a esuat)
  errorMessage   String?    @map("error_message")
  createdAt      DateTime   @default(now()) @map("created_at")
  startedAt      DateTime?  @map("started_at")
  finishedAt     DateTime?  @map("finished_at")

  ruleResults RuleResult[]

  @@index([projectId, createdAt])
  @@index([status, createdAt]) // worker-ul cauta rapid urmatoarea scanare "queued"
  @@map("scans")
}

// Rezultatul unei reguli axe-core intr-o scanare (ex. "image-alt: violation").
model RuleResult {
  id           String         @id @default(uuid())
  scanId       String         @map("scan_id") // scanarea careia ii apartine
  scan         Scan           @relation(fields: [scanId], references: [id], onDelete: Cascade)
  axeRuleId    String         @map("axe_rule_id") // identificatorul regulii, ex. "image-alt"
  category     ResultCategory // violation / incomplete / pass / inapplicable
  impact       Impact? // gravitatea, doar pentru violation si incomplete
  title        String // titlul scurt al regulii (campul "help" din axe)
  description  String // ce verifica regula
  docsUrl      String         @map("docs_url") // documentatia oficiala a regulii
  axeTags      String[]       @map("axe_tags") // etichetele axe, ex. ["wcag2a", "wcag111"]
  wcagCriteria String[]       @map("wcag_criteria") // criteriile WCAG deduse, ex. ["1.1.1"]
  createdAt    DateTime       @default(now()) @map("created_at")

  affectedElements AffectedElement[]

  @@unique([scanId, axeRuleId, category])
  @@index([scanId, category])
  @@map("rule_results")
}

// Un element concret din pagina afectat de o regula (ex. o anumita imagine).
model AffectedElement {
  id             String     @id @default(uuid())
  ruleResultId   String     @map("rule_result_id") // rezultatul caruia ii apartine
  ruleResult     RuleResult @relation(fields: [ruleResultId], references: [id], onDelete: Cascade)
  cssSelector    Json       @map("css_selector") // cum gasesti elementul, ex. ["img.hero"]
  htmlSnippet    String     @map("html_snippet") // fragmentul HTML (trunchiat), afisat sanitizat
  failureSummary String?    @map("failure_summary") // explicatia axe: ce anume e gresit
  // Amprenta elementului: aceeasi problema, pe acelasi element, are aceeasi amprenta
  // in scanari diferite. Folosita la comparatia inainte/dupa (Fix & Re-scan).
  fingerprint    String

  @@index([ruleResultId])
  @@index([fingerprint])
  @@map("affected_elements")
}
