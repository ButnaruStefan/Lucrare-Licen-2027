// Schema bazei de date: descrie tabelele (modelele) si relatiile dintre ele.
// Din acest fisier, Prisma genereaza:
//   1) migratiile SQL (prisma/migrations/) care creeaza tabelele in PostgreSQL;
//   2) clientul TypeScript (src/generated/prisma/) cu care API-ul citeste si scrie date.
// Adresa bazei de date NU e aici, ci in prisma.config.ts (citita din .env).

// Aici este cum arata baza de date in final (schema). Migartions e efectiv jurnalul prin care am ajuns noi aici (modificare dupa modificare)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Conventia de denumire:
//   - in cod (TypeScript), numele sunt in stilul camelCase: Scan, pageUrl, createdAt;
//   - in baza de date (ce vezi in Prisma Studio si in SQL), in stilul snake_case, la plural
//     pentru tabele: scans, page_url, created_at. Legatura e facuta de @map si @@map.
//
// Relatiile, pe scurt:
//   Project 1 ── N Scan 1 ── N RuleResult 1 ── N AffectedElement
//   (un proiect are mai multe scanari; o scanare are cate un rezultat pentru fiecare regula
//    verificata; un rezultat poate afecta mai multe elemente din pagina)
//   Project 1 ── N Audit 1 ── N Scan
//   (un audit verifica mai multe pagini ale aceluiasi site: fiecare pagina e o scanare obisnuita)

// ─── Liste de valori permise (enum) ─────────────────────────────────────────────

// Starea unei scanari. Scanarile "queued" formeaza coada de lucru a worker-ului care ruleaza scanarile.
enum ScanStatus {
  queued // in asteptare
  running // in curs
  completed // terminata cu rezultate
  failed // esuata (eroare tehnica, NU inseamna ca site-ul e inaccesibil)

  @@map("scan_status")
}

// Cele patru categorii de rezultate ale axe-core pentru o regula.
enum ResultCategory {
  violation // problema detectata
  incomplete // motorul nu poate decide: cere verificare umana
  pass // regula trecuta (NU inseamna conformitate generala)
  inapplicable // regula nu se aplica acestei pagini

  @@map("result_category")
}

// Etapa in care se afla un audit pe mai multe pagini. Starea "finalizat" nu se salveaza:
// se calculeaza din starea scanarilor paginilor (un audit e gata cand nicio pagina nu mai asteapta).
enum AuditStatus {
  discovery_queued // asteapta descoperirea paginilor
  discovering // worker-ul cauta paginile site-ului
  awaiting_selection // paginile au fost gasite: utilizatorul alege ce se scaneaza
  scanning // paginile alese sunt scanate (sau au fost scanate)
  failed // descoperirea a esuat (ex. pagina de start nu se deschide)

  @@map("audit_status")
}

// Gravitatea raportata de axe-core (nu e risc juridic si nici scor de conformitate).
enum Impact {
  minor
  moderate
  serious
  critical

  @@map("impact")
}

// ─── Tabele ─────────────────────────────────────────────────────────────────────

// Un proiect = un site analizat (ex. site-ul unei universitati).
model Project {
  id        String   @id @default(uuid())
  name      String // numele afisat, ex. "Primaria Valea Verde"
  baseUrl   String   @map("base_url") // adresa principala a site-ului
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  scans        Scan[]
  audits       Audit[]
  legalProfile LegalProfile?

  @@map("projects")
}

// Profilul juridic al unui proiect: raspunsurile la chestionarul OUG 112/2018
// si concluzia privind aplicabilitatea legii. Unul per proiect (relatie 1-1).
model LegalProfile {
  id             String   @id @default(uuid())
  projectId      String   @unique @map("project_id")
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  framework      String   @default("RO_OUG_112_2018") // cadrul normativ evaluat
  answers        Json // raspunsurile brute la chestionar
  status         String // ex. "in_scope", "out_of_scope", "uncertain"
  assessment     Json // concluzia structurata: aplicabilitate, articole aplicabile etc.
  catalogVersion String   @map("catalog_version") // versiunea catalogului la momentul evaluarii
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("legal_profiles")
}

// Un audit = verificarea mai multor pagini ale aceluiasi site, intr-o singura actiune:
//   1. worker-ul deschide pagina de start si gaseste paginile site-ului (linkuri, sitemap.xml);
//   2. aplicatia propune un esantion (pagini esentiale, cate una din fiecare sectiune, aleatorii);
//   3. utilizatorul confirma lista, iar fiecare pagina aleasa devine o scanare obisnuita.
model Audit {
  id                 String      @id @default(uuid())
  projectId          String      @map("project_id")
  project            Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  startUrl           String      @map("start_url") // pagina de la care incepe descoperirea
  maxPages           Int         @map("max_pages") // cate pagini propunem, cel mult
  status             AuditStatus @default(discovery_queued)
  config             Json // configuratia scanarii, aceeasi pentru toate paginile
  catalogVersion     String      @map("catalog_version") // versiunea catalogului normativ
  discovery          Json? // ce s-a gasit: pagini candidate, servicii externe, documente, excluderi
  errorCode          String?     @map("error_code") // doar daca descoperirea a esuat
  errorMessage       String?     @map("error_message")
  createdAt          DateTime    @default(now()) @map("created_at")
  discoveryStartedAt DateTime?   @map("discovery_started_at")
  discoveredAt       DateTime?   @map("discovered_at")
  selectedAt         DateTime?   @map("selected_at") // cand a confirmat utilizatorul lista

  scans Scan[]

  @@index([projectId, createdAt])
  @@index([status, createdAt]) // worker-ul cauta rapid urmatoarea descoperire in asteptare
  @@map("audits")
}

// O scanare = o rulare a motorului axe-core pe o pagina, la un moment dat,
// cu o configuratie fixata (ca rezultatele sa fie reproductibile si comparabile).
model Scan {
  id             String     @id @default(uuid())
  projectId      String     @map("project_id") // proiectul caruia ii apartine
  project        Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  auditId        String?    @map("audit_id") // auditul din care face parte (null = scanare separata)
  audit          Audit?     @relation(fields: [auditId], references: [id], onDelete: Cascade)
  pageUrl        String     @map("page_url") // adresa paginii scanate
  finalUrl       String?    @map("final_url") // adresa reala dupa redirectionari
  httpStatus     Int?       @map("http_status") // codul HTTP primit la incarcarea paginii
  status         ScanStatus @default(queued)
  wcagProfile    String     @default("WCAG_2_2_AA") @map("wcag_profile") // standardul verificat
  config         Json // viewport, limba, timeout etc. — fixate la creare
  engineName     String?    @map("engine_name") // ex. "axe-core"
  engineVersion  String?    @map("engine_version") // ex. "4.13.0"
  browserVersion String?    @map("browser_version") // ex. "Chrome 155.0.8059.40"
  catalogVersion String?    @map("catalog_version") // versiunea catalogului normativ la momentul scanarii
  rawAxeResult   Json?      @map("raw_axe_result") // rezultatul brut, pastrat neschimbat ca dovada
  errorCode      String?    @map("error_code") // ex. "NAVIGATION_TIMEOUT" (doar daca a esuat)
  errorMessage   String?    @map("error_message")
  createdAt      DateTime   @default(now()) @map("created_at")
  startedAt      DateTime?  @map("started_at")
  finishedAt     DateTime?  @map("finished_at")

  ruleResults RuleResult[]
  screenshot  ScanScreenshot? // captura paginii (harta problemelor); lipseste daca nu a reusit
  layout      ScanLayout? // verificarea aspectului paginii; lipseste daca nu a fost ceruta

  @@index([projectId, createdAt])
  @@index([status, createdAt]) // worker-ul cauta rapid urmatoarea scanare "queued"
  @@index([auditId])
  @@map("scans")
}

// Captura paginii scanate, facuta imediat dupa axe-core, in aceeasi sesiune de browser.
// Interfata deseneaza peste ea chenarele elementelor afectate ("harta problemelor").
// Separata de "scans" ca lista scanarilor sa nu incarce niciodata imaginile.
model ScanScreenshot {
  scanId       String   @id @map("scan_id")
  scan         Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  image        Bytes // imaginea (WebP), cel mult cateva sute de KB
  format       String // tipul imaginii, ex. "webp"
  width        Int // latimea capturii, in pixeli CSS
  height       Int // inaltimea capturii (taiata la limita, daca pagina e foarte lunga)
  pageHeight   Int      @map("page_height") // inaltimea reala a paginii
  truncated    Boolean // true = pagina era mai lunga decat captura
  // Captura facuta ecran cu ecran: inaltimea unui ecran si derularea la care a fost fotografiat
  // fiecare (ecranele sunt unul sub altul in imagine). null / [] = o singura imagine a paginii.
  frameHeight  Int?     @map("frame_height")
  frameOffsets Int[]    @default([]) @map("frame_offsets")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("scan_screenshots")
}

// Verificarea aspectului paginii (separata complet de WCAG): fereastra browserului e ingustata
// pas cu pas, iar aranjarea paginii e comparata cu ea insasi la latimi vecine.
model ScanLayout {
  scanId       String        @id @map("scan_id")
  scan         Scan          @relation(fields: [scanId], references: [id], onDelete: Cascade)
  widths       Int[] // latimile ferestrei verificate (px), de la mare la mic
  breakpoints  Json // media queries gasite in CSS-ul paginii (min-width / max-width)
  metaViewport String?       @map("meta_viewport") // continutul meta viewport (null = lipseste)
  durationMs   Int           @map("duration_ms") // cat a durat verificarea
  partial      Boolean       @default(false) // oprita la limita de timp, inainte de toate latimile
  error        String? // de ce nu s-a putut face verificarea (null = s-a facut)
  createdAt    DateTime      @default(now()) @map("created_at")
  issues       LayoutIssue[]

  @@map("scan_layouts")
}

// Un semnal de aspect (ex. doua elemente care se suprapun intre 780 si 830 px).
model LayoutIssue {
  id            String     @id @default(uuid())
  scanId        String     @map("scan_id")
  layout        ScanLayout @relation(fields: [scanId], references: [scanId], onDelete: Cascade)
  kind          String // tipul semnalului, ex. "elemente-suprapuse"
  level         String // "visible" (sigur se vede), "possible" (de confirmat), "info"
  widthMin      Int?       @map("width_min") // intervalul de latimi la care apare (null = oricare)
  widthMax      Int?       @map("width_max")
  elements      Json // elementele implicate: selector, fragment HTML, text
  details       Json // masuratori (cu cat iese, cat se suprapun, regulile CSS)
  fingerprint   String // acelasi semnal pe acelasi element are aceeasi amprenta in scanari diferite
  image         Bytes? // captura decupata in jurul elementelor, la latimea problemei (JPEG)
  imageFormat   String?    @map("image_format")
  imageWidth    Int?       @map("image_width")
  imageHeight   Int?       @map("image_height")
  imageViewport Int?       @map("image_viewport") // latimea ferestrei la care a fost facuta captura
  boxes         Json // chenarele elementelor in captura (pixeli, fata de coltul capturii)

  @@index([scanId])
  @@map("layout_issues")
}

// Rezultatul unei reguli axe-core intr-o scanare (ex. "image-alt: violation").
model RuleResult {
  id           String         @id @default(uuid())
  scanId       String         @map("scan_id") // scanarea careia ii apartiness
  scan         Scan           @relation(fields: [scanId], references: [id], onDelete: Cascade)
  axeRuleId    String         @map("axe_rule_id") // identificatorul regulii, ex. "image-alt"
  category     ResultCategory // violation / incomplete / pass / inapplicable
  impact       Impact? // gravitatea, doar pentru violation si incomplete
  title        String // titlul scurt al regulii (campul "help" din axe)
  description  String // ce verifica regula
  docsUrl      String         @map("docs_url") // documentatia oficiala a regulii
  axeTags      String[]       @map("axe_tags") // etichetele axe, ex. ["wcag2a", "wcag111"]
  wcagCriteria String[]       @map("wcag_criteria") // criteriile WCAG deduse, ex. ["1.1.1"]
  createdAt    DateTime       @default(now()) @map("created_at")

  affectedElements AffectedElement[]

  @@unique([scanId, axeRuleId, category])
  @@index([scanId, category])
  @@map("rule_results")
}

// Un element concret din pagina afectat de o regula (ex. o anumita imagine).
model AffectedElement {
  id             String     @id @default(uuid())
  ruleResultId   String     @map("rule_result_id") // rezultatul caruia ii apartine
  ruleResult     RuleResult @relation(fields: [ruleResultId], references: [id], onDelete: Cascade)
  cssSelector    Json       @map("css_selector") // cum gasesti elementul, ex. ["img.hero"]
  htmlSnippet    String     @map("html_snippet") // fragmentul HTML (trunchiat), afisat sanitizat
  failureSummary String?    @map("failure_summary") // explicatia axe: ce anume e gresit
  // Amprenta elementului: aceeasi problema, pe acelasi element, are aceeasi amprenta
  // in scanari diferite. Folosita la comparatia inainte/dupa (Fix & Re-scan).
  fingerprint    String
  // Pozitia elementului in captura paginii (pixeli CSS, fata de coltul paginii).
  // null = elementul nu se vede in captura (ascuns, fara dimensiune sau intr-un iframe).
  boxX           Int?       @map("box_x")
  boxY           Int?       @map("box_y")
  boxWidth       Int?       @map("box_width")
  boxHeight      Int?       @map("box_height")

  @@index([ruleResultId])
  @@index([fingerprint])
  @@map("affected_elements")
}
