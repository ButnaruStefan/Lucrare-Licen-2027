{
  "name": "ro-a11y-observatory",
  "private": true,
  "description": "Platforma de audit al accesibilitatii web pentru site-uri romanesti (lucrare de licenta).",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "fixtures"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @ro-a11y/api",
    "dev:worker": "npm run dev:worker -w @ro-a11y/api",
    "dev:web": "npm run dev -w @ro-a11y/web",
    "dev:fixtures": "npm run dev -w @ro-a11y/fixtures",
    "db:migrate": "npm run db:migrate -w @ro-a11y/api",
    "db:seed": "npm run db:seed -w @ro-a11y/api",
    "db:studio": "npm run db:studio -w @ro-a11y/api",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
